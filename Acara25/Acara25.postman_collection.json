{
  "info": {
    "name": "Acara 25 - Authentication, Authorization, dan Dashboard Admin",
    "description": "Collection praktikum BKPM Acara 25. Jalankan berurutan; request menyimpan token dan ID sementara secara otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "if (pm.response.code !== 204) pm.test(\"Response API berformat JSON\", () => pm.expect(contentType).to.include(\"application/json\"));",
          "if (contentType.includes(\"application/json\")) {",
          "  const j = pm.response.json(); pm.test(\"Response berbentuk envelope\", () => [\"success\", \"message\", \"data\", \"errors\", \"timestamp\"].forEach(k => pm.expect(j).to.have.property(k)));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Register (201 atau sudah terdaftar 409)",
