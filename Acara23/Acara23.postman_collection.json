{
  "info": {
    "name": "Acara 23 - Manual dan Black-box Testing",
    "description": "Collection praktikum BKPM Acara 23. Jalankan berurutan; request menyimpan token dan ID sementara secara otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "if (pm.response.code !== 204) pm.test(\"Response API berformat JSON\", () => pm.expect(contentType).to.include(\"application/json\"));",
          "if (contentType.includes(\"application/json\")) {",
          "  const j = pm.response.json(); pm.test(\"Response berbentuk envelope\", () => [\"success\", \"message\", \"data\", \"errors\", \"timestamp\"].forEach(k => pm.expect(j).to.have.property(k)));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Register (201 atau sudah terdaftar 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/register"
        },
        "description": "AuthController::register(); boleh 409 saat collection diulang.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"praktikum23\",\n  \"email\": \"praktikum23@example.com\",\n  \"password\": \"rahasia123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registrasi berhasil atau akun sudah ada', () => pm.expect([201, 409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
