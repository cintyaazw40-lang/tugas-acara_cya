            ],
            "url": {
              "raw": "{{base_url}}/mahasiswa"
            },
            "description": "POST /mahasiswa",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"{{test_nim}}\",\n  \"nama\": \"Data Uji Acara 23\",\n  \"prodi\": \"Teknik Informatika\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"test_nim\", \"99\" + Date.now().toString().slice(-7));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"test_id\", pm.response.json().data.id);"
