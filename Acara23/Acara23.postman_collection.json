      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json(); pm.collectionVariables.set(\"token\", j.data.token); pm.test(\"Token berlaku 300 detik\", () => pm.expect(j.data.expires_in).to.eql(300));"
